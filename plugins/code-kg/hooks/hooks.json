{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep|Glob|Read|LS",
        "hooks": [
          {
            "type": "command",
            "command": "code-kg hook-check",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "code-kg session-check",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "code-kg agent-context session",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "code-kg agent-context prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "code-kg agent-context edit",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "code-kg agent-context stop",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
