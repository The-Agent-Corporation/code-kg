{
  "name": "code-kg",
  "version": "0.1.0",
  "description": "A persistent, reviewable code knowledge graph for AI agents",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "tree-sitter",
      "tree-sitter-typescript",
      "tree-sitter-python",
      "tree-sitter-go",
      "tree-sitter-java",
      "tree-sitter-kotlin",
      "tree-sitter-swift",
      "tree-sitter-php",
      "@davisvaughan/tree-sitter-r"
    ],
    "overrides": {
      "tree-sitter-swift>tree-sitter": "0.21.1"
    }
  },
  "keywords": [
    "markdown",
    "knowledge-graph",
    "documentation",
    "agents",
    "cli",
    "wiki-links",
    "codebase"
  ],
  "bin": {
    "code-kg": "dist/src/codekg/cli.js"
  },
  "files": [
    "dist/src",
    "templates",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "tsc && node scripts/copy-vendor-assets.mjs",
    "pretest": "pnpm build",
    "test": "vitest run && node --test plugins/openclaw-code-kg/tests/bridge.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "cook-test-rag": "tsx scripts/cook-test-rag.ts",
    "test:package": "pnpm build && node scripts/verify-package.mjs",
    "test:skill-evals": "node scripts/run-skill-evals.mjs"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.3.0",
    "mdast-util-from-markdown": "^2.0.3",
    "micromark-util-types": "^2.0.2",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@folder/xdg": "^4.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@libsql/client": "^0.17.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@repomix/tree-sitter-wasms": "^0.1.16",
    "commander": "^14.0.3",
    "ignore-walk": "^8.0.0",
    "mdast-util-to-markdown": "^2.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tree-sitter": "0.21.1",
    "tree-sitter-go": "0.23.4",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-kotlin": "0.3.8",
    "tree-sitter-php": "0.23.12",
    "tree-sitter-python": "0.21.0",
    "tree-sitter-r": "npm:@davisvaughan/tree-sitter-r@1.3.0",
    "tree-sitter-swift": "0.7.1",
    "tree-sitter-typescript": "0.23.2",
    "tree-sitter-wasm": "1.1.6",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0",
    "web-tree-sitter": "^0.26.6",
    "zod": "^4.3.6"
  },
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "author": ""
}
