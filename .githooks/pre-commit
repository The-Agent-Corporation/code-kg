#!/bin/sh
# Code-KG pre-commit hook
# code-kg:managed-hook
# Keeps the lat.md/ knowledge graph in sync with every commit: regenerates the
# generated sections, rebuilds the semantic index, validates, and stages the
# tracked KB files so the knowledge update rides the SAME commit as the code.
#
# Regeneration reads the working tree, so unstaged source edits are reflected
# in the knowledge base. LLM paragraph enrichment is skipped here; run
# `code-kg update` yourself, or commit with CODEKG_SKIP_ENRICH=0, to include it.
# A remote embedding provider, if configured, is still called for the reindex.
#
# Installed by `code-kg git-hooks install`. Re-running install updates it in
# place. Bypass for a single commit with:  git commit --no-verify

# Nothing to do if the code-kg CLI isn't on PATH.
if ! command -v code-kg >/dev/null 2>&1; then
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)

# Only act in repos that actually have a Code-KG knowledge base.
if [ ! -d "$repo_root/lat.md" ]; then
  exit 0
fi

# Auto-staging is only safe when every pending knowledge-base change comes from
# this hook; otherwise `git add` would sweep unstaged hand edits into the commit,
# or replace a staged manifest edit with the regenerated manifest.
manifest=".code-kg/materialization-manifest.json"
kb_paths="lat.md $manifest"
kb_changed() {
  # shellcheck disable=SC2086
  ! git -C "$repo_root" diff --quiet -- $kb_paths ||
    [ -n "$(git -C "$repo_root" ls-files --others --exclude-standard -- $kb_paths)" ]
}
kb_dirty=""
if kb_changed || ! git -C "$repo_root" diff --cached --quiet -- "$manifest"; then
  kb_dirty=1
fi

echo "[code-kg] syncing knowledge graph (materialize + semantic reindex + check + drift)..."

# `code-kg update` exits non-zero only when `check` fails (broken links / invalid
# metadata). Drift is advisory and does NOT block the commit.
CODEKG_SKIP_ENRICH="${CODEKG_SKIP_ENRICH:-1}"
export CODEKG_SKIP_ENRICH
if ! code-kg --dir "$repo_root" update; then
  echo ""
  echo "[code-kg] update failed: 'code-kg check' did not pass (see output above)."
  echo "[code-kg] Fix the reported issues, or bypass once with: git commit --no-verify"
  exit 1
fi

if ! kb_changed; then
  : # The knowledge base was already current; nothing to stage.
elif [ -n "$kb_dirty" ]; then
  echo "[code-kg] NOTE: lat.md/ or the manifest had changes this hook did not make"
  echo "[code-kg]       (unstaged edits, or a staged manifest edit), so the refreshed"
  echo "[code-kg]       knowledge base was NOT staged. It stays unstaged on later commits"
  echo "[code-kg]       until you review it with 'git diff -- lat.md .code-kg' and stage"
  echo "[code-kg]       or discard it. Changes from running 'code-kg update' yourself are"
  echo "[code-kg]       safe to stage: git add lat.md $manifest"
else
  # Stage the regenerated, tracked knowledge-base files into this commit.
  # shellcheck disable=SC2086
  git -C "$repo_root" add -- $kb_paths 2>/dev/null
fi

# Sections you hand-edited are never overwritten — instead a candidate lands in
# merge-proposals/ for manual review. Surface that so it isn't missed.
proposals_dir="$repo_root/.code-kg/cache/merge-proposals"
if [ -d "$proposals_dir" ] && [ -n "$(ls -A "$proposals_dir" 2>/dev/null)" ]; then
  echo "[code-kg] NOTE: merge proposals are pending in .code-kg/cache/merge-proposals/"
  echo "[code-kg]       (edited/curated sections changed upstream — review them manually)."
fi

exit 0
